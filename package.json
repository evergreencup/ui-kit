{
  "name": "@evergreencup/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Evergreen Cup brand and React components for Next.js: the Pacific Northwest palette as a Tailwind 4 theme, the wordmark and conifer glyph, layered PNW atmosphere backdrops, buttons, panels, form fields, the site header and footer, tables, chart frames, osu! mappool rows and tournament pieces.",
  "license": "MIT",
  "author": "David (https://dvh.sh)",
  "homepage": "https://evergreencup.github.io/ui-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evergreencup/ui-kit.git"
  },
  "bugs": "https://github.com/evergreencup/ui-kit/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "default": "./dist/mdx.js"
    },
    "./site": {
      "types": "./dist/site.d.ts",
      "default": "./dist/site.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/theme.css','dist/theme.css')\"",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:consumer": "node scripts/check-consumer.mjs",
    "demo:build": "node scripts/check-consumer.mjs --out demo-out"
  },
  "dependencies": {
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "next": ">=16.0.0 <17",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.1.0 <5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
